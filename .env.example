# .env.example — copy to .env and fill in values
APP_DATA_DIR=data
APP_MAX_ITERATIONS=5

# LLM (Ollama — local open-source models)
# Run: ollama serve (in background), then: ollama pull zephyr
APP_LLM_HOST=http://localhost:11434
APP_LLM_DEFAULT_MODEL=zephyr
APP_LLM_TIMEOUT_SECONDS=60
APP_LLM_MAX_RETRIES=3

# Deprecated: Anthropic API key (no longer used — kept for reference only)
# APP_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Resume pipeline
APP_WHITESPACE_THRESHOLD=40.0
APP_EXPAND_SECTIONS_DEFAULT=["WORK EXPERIENCE"]

# Cover letter cleaning
APP_COVER_LETTER_BULLET_CHAR=•
# APP_COVER_LETTER_PREAMBLE_PATTERNS=["^.*?(?=Dear\\s+Hiring)"]

# Paths
APP_TEMPLATES_DIR=templates
