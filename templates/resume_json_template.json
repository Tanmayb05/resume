{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/compact-2col-ats-resume.schema.json",
  "title": "Compact ATS Resume (Two-Column Date Layout) - LLM Generation Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "style", "header", "sections"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateName", "version", "engine", "output"],
      "properties": {
        "templateName": { "type": "string", "default": "compact_2col_ats_resume" },
        "version": { "type": "string", "default": "1.0.0" },
        "engine": {
          "type": "string",
          "enum": ["pdflatex", "xelatex", "lualatex"],
          "default": "pdflatex"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format"],
          "properties": {
            "format": { "type": "string", "enum": ["latex"], "default": "latex" },
            "targetPages": { "type": "integer", "minimum": 1, "maximum": 1, "default": 1 },
            "atsReadable": { "type": "boolean", "default": true }
          }
        }
      }
    },

    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "page", "typography", "sections", "lists", "layout", "constraints"],
      "properties": {
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "options"],
          "properties": {
            "class": { "type": "string", "const": "article" },
            "options": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["9pt", "letterpaper"]
            }
          }
        },

        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["geometry"],
          "properties": {
            "geometry": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ignoreHeadFoot", "topCm", "bottomCm", "leftCm", "rightCm", "footskipCm"],
              "properties": {
                "ignoreHeadFoot": { "type": "boolean", "default": true },
                "topCm": { "type": "number", "const": 0.5 },
                "bottomCm": { "type": "number", "const": 0.5 },
                "leftCm": { "type": "number", "const": 0.7 },
                "rightCm": { "type": "number", "const": 0.7 },
                "footskipCm": { "type": "number", "default": 0.2 }
              }
            }
          }
        },

        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fontFamily",
            "raggedRight",
            "paragraphIndentPt",
            "topSkipPt",
            "pageStyle",
            "pageNumbering"
          ],
          "properties": {
            "fontFamily": { "type": "string", "const": "charter" },
            "raggedRight": { "type": "boolean", "default": true },
            "paragraphIndentPt": { "type": "number", "const": 0 },
            "topSkipPt": { "type": "number", "const": 0 },
            "pageStyle": { "type": "string", "const": "empty" },
            "pageNumbering": { "type": "string", "const": "gobble" }
          }
        },

        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columnSepCm", "rightDateColumnWidthCm"],
          "properties": {
            "columnSepCm": { "type": "number", "default": 0.15 },
            "rightDateColumnWidthCm": { "type": "number", "default": 4.5 }
          }
        },

        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["uppercaseTitles", "bold", "size", "ruleUnderTitle", "spacing"],
          "properties": {
            "uppercaseTitles": { "type": "boolean", "default": true },
            "bold": { "type": "boolean", "default": true },
            "size": { "type": "string", "enum": ["large"], "default": "large" },
            "ruleUnderTitle": { "type": "boolean", "default": true },
            "spacing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["leftPt", "topCm", "bottomCm"],
              "properties": {
                "leftPt": { "type": "integer", "const": -1 },
                "topCm": { "type": "number", "const": 0.05 },
                "bottomCm": { "type": "number", "const": 0.05 }
              }
            }
          }
        },

        "lists": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bullet", "highlights"],
          "properties": {
            "bullet": { "type": "string", "default": "small_bullet" },
            "highlights": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topsepCm", "parsepPt", "partopsepPt", "itemsepPt", "leftmarginPt"],
              "properties": {
                "topsepCm": { "type": "number", "default": 0.05 },
                "parsepPt": { "type": "integer", "default": 0 },
                "partopsepPt": { "type": "integer", "default": 0 },
                "itemsepPt": { "type": "integer", "default": 0 },
                "leftmarginPt": { "type": "integer", "default": 10 }
              }
            }
          }
        },

        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["singlePage", "noGraphics", "noTablesForLayout", "noIcons", "noEmDash", "noFirstPerson"],
          "properties": {
            "singlePage": { "type": "boolean", "default": true },
            "noGraphics": { "type": "boolean", "default": true },
            "noTablesForLayout": { "type": "boolean", "default": true },
            "noIcons": { "type": "boolean", "default": true },
            "noEmDash": { "type": "boolean", "default": true },
            "noFirstPerson": { "type": "boolean", "default": true }
          }
        }
      }
    },

    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "nameFontPt", "nameLineHeightPt", "contactLine", "separator"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "nameFontPt": { "type": "integer", "default": 16 },
        "nameLineHeightPt": { "type": "integer", "default": 26 },
        "separator": { "type": "string", "const": "|" },
        "contactLine": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["location", "linkedin", "github", "portfolio", "email", "phone", "other"]
              },
              "text": { "type": "string", "minLength": 1 },
              "url": { "type": "string" }
            }
          }
        }
      }
    },

    "sections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Fixed order: EDUCATION, TECHNICAL SKILLS, WORK EXPERIENCE, PROJECTS AND RESEARCH, EXTRACURRICULAR ACTIVITIES",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/educationSection" },
          { "$ref": "#/$defs/skillsSection" },
          { "$ref": "#/$defs/experienceSection" },
          { "$ref": "#/$defs/projectsSection" },
          { "$ref": "#/$defs/extracurricularSection" }
        ]
      }
    }
  },

  "$defs": {
    "twocolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leftText", "rightText"],
      "properties": {
        "leftText": { "type": "string", "minLength": 1 },
        "rightText": { "type": "string", "minLength": 1 },
        "leftBold": { "type": "boolean", "default": true },
        "rightAlign": { "type": "boolean", "default": true }
      }
    },

    "highlights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 5,
        "description": "One sentence each. Start with action verb. Prefer metrics. No first-person. Avoid em-dash."
      }
    },

    "educationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degree", "institution", "dates", "courseworkLine"],
      "properties": {
        "degree": { "type": "string", "minLength": 2 },
        "institution": { "type": "string", "minLength": 2 },
        "dates": { "type": "string", "minLength": 4, "description": "Example: Aug 2024 - Aug 2026" },
        "courseworkLine": {
          "type": "string",
          "minLength": 10,
          "description": "Single inline sentence, e.g., Relevant Coursework: A, B, C."
        }
      }
    },

    "educationSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "entries"],
      "properties": {
        "type": { "type": "string", "const": "education" },
        "title": { "type": "string", "const": "EDUCATION" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/educationEntry" }
        }
      }
    },

    "skillsLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "minLength": 2, "description": "Bold label, e.g., Programming & Scripting" },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },

    "skillsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "lines"],
      "properties": {
        "type": { "type": "string", "const": "technical_skills" },
        "title": { "type": "string", "const": "TECHNICAL SKILLS" },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/skillsLine" }
        }
      }
    },

    "experienceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "role", "dates", "techStack", "bullets"],
      "properties": {
        "company": { "type": "string", "minLength": 2 },
        "role": { "type": "string", "minLength": 2, "description": "Rendered as (Role)" },
        "dates": { "type": "string", "minLength": 4 },
        "location": { "type": "string" },
        "techStack": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "bullets": { "$ref": "#/$defs/highlights" }
      }
    },

    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "entries"],
      "properties": {
        "type": { "type": "string", "const": "work_experience" },
        "title": { "type": "string", "const": "WORK EXPERIENCE" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/experienceEntry" }
        }
      }
    },

    "projectEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "techBracket", "bullets"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "date": { "type": "string", "minLength": 3, "description": "Example: Mar 2025" },
        "techBracket": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "linkText": { "type": "string", "description": "Optional: e.g., Published Paper ID - XYZ" },
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },

    "projectsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "entries"],
      "properties": {
        "type": { "type": "string", "const": "projects_and_research" },
        "title": { "type": "string", "const": "PROJECTS AND RESEARCH" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/projectEntry" }
        }
      }
    },

    "extracurricularSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "bullets"],
      "properties": {
        "type": { "type": "string", "const": "extracurricular" },
        "title": { "type": "string", "const": "EXTRACURRICULAR ACTIVITIES" },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    }
  },

  "examples": [
    {
      "meta": {
        "templateName": "compact_2col_ats_resume",
        "version": "1.0.0",
        "engine": "pdflatex",
        "output": { "format": "latex", "targetPages": 1, "atsReadable": true }
      },
      "style": {
        "document": { "class": "article", "options": ["9pt", "letterpaper"] },
        "page": { "geometry": { "ignoreHeadFoot": true, "topCm": 0.5, "bottomCm": 0.5, "leftCm": 0.7, "rightCm": 0.7, "footskipCm": 0.2 } },
        "typography": { "fontFamily": "charter", "raggedRight": true, "paragraphIndentPt": 0, "topSkipPt": 0, "pageStyle": "empty", "pageNumbering": "gobble" },
        "layout": { "columnSepCm": 0.15, "rightDateColumnWidthCm": 4.5 },
        "sections": { "uppercaseTitles": true, "bold": true, "size": "large", "ruleUnderTitle": true, "spacing": { "leftPt": -1, "topCm": 0.05, "bottomCm": 0.05 } },
        "lists": { "bullet": "small_bullet", "highlights": { "topsepCm": 0.05, "parsepPt": 0, "partopsepPt": 0, "itemsepPt": 0, "leftmarginPt": 10 } },
        "constraints": { "singlePage": true, "noGraphics": true, "noTablesForLayout": true, "noIcons": true, "noEmDash": true, "noFirstPerson": true }
      },
      "header": {
        "name": "Candidate Name",
        "nameFontPt": 16,
        "nameLineHeightPt": 26,
        "separator": "|",
        "contactLine": [
          { "kind": "location", "text": "City, ST" },
          { "kind": "linkedin", "text": "linkedin.com/in/handle" },
          { "kind": "portfolio", "text": "portfolio.site" },
          { "kind": "email", "text": "name@email.com" }
        ]
      },
      "sections": [
        {
          "type": "education",
          "title": "EDUCATION",
          "entries": [
            {
              "degree": "Master of Science in Computer Science",
              "institution": "University Name",
              "dates": "Aug 2024 - Aug 2026",
              "courseworkLine": "Relevant Coursework: A, B, C, D."
            }
          ]
        },
        {
          "type": "technical_skills",
          "title": "TECHNICAL SKILLS",
          "lines": [
            { "label": "Programming & Scripting", "items": ["Python", "Java", "SQL"] },
            { "label": "Frameworks", "items": ["React", "FastAPI"] }
          ]
        },
        {
          "type": "work_experience",
          "title": "WORK EXPERIENCE",
          "entries": [
            {
              "company": "Company Name",
              "role": "Software Engineer",
              "dates": "Jul 2022 - Jun 2024",
              "techStack": ["AWS", "Python", "Docker"],
              "bullets": [
                "Automated deployment workflows, reducing release time by 30%.",
                "Improved system reliability by implementing CI checks and monitoring."
              ]
            }
          ]
        },
        {
          "type": "projects_and_research",
          "title": "PROJECTS AND RESEARCH",
          "entries": [
            {
              "title": "Project Title",
              "date": "Mar 2025",
              "techBracket": ["Python", "PyTorch"],
              "bullets": [
                "Built a model that achieved 93% accuracy on a held-out test set.",
                "Optimized preprocessing to reduce training time by 25%."
              ]
            }
          ]
        },
        {
          "type": "extracurricular",
          "title": "EXTRACURRICULAR ACTIVITIES",
          "bullets": [
            "Finalist in a hackathon, selected among 300 participants across 31 schools."
          ]
        }
      ]
    }
  ]
}